<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pixel Clock Widget Provider -->
        <receiver
            android:name=".widget.PixelClockAppWidgetProvider"
            android:exported="true"
            android:label="Pixel Clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pixel_clock_widget_info" />
        </receiver>

        <!-- Pixel Weather Widget Provider -->
        <receiver
            android:name=".widget.PixelWeatherAppWidgetProvider"
            android:exported="true"
            android:label="Pixel Weather">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pixel_weather_widget_info" />
        </receiver>

        <!-- Pixel Battery Widget Provider -->
        <receiver
            android:name=".widget.PixelBatteryAppWidgetProvider"
            android:exported="true"
            android:label="Pixel Battery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pixel_battery_widget_info" />
        </receiver>

        <!-- Pixel Music Widget Provider -->
        <receiver
            android:name=".widget.PixelMusicAppWidgetProvider"
            android:exported="true"
            android:label="Pixel Media">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pixel_music_widget_info" />
        </receiver>

        <!-- Pixel Quote Widget Provider -->
        <receiver
            android:name=".widget.PixelQuoteAppWidgetProvider"
            android:exported="true"
            android:label="Pixel Quotes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pixel_quote_widget_info" />
        </receiver>

        <!-- Pixel Custom User Widget Provider -->
        <receiver
            android:name=".widget.PixelCustomAppWidgetProvider"
            android:exported="true"
            android:label="Custom Material You Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pixel_custom_widget_info" />
        </receiver>
    </application>

</manifest>
